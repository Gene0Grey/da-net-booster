<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- CI overrides both from the git tag and repo: -p:Version=1.4.0 -p:UpdateRepo=https://github.com/owner/repo -->
    <Version>1.3.0</Version>
    <UpdateRepo></UpdateRepo>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <!-- adb, hev-socks5-tunnel, wintun.dll, phone APK: filled by scripts/fetch-tools.ps1 -->
    <None Include="tools\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

</Project>
